# Optional; set these environment variables in your shell before starting.
NATUREDEX_DEVICE=cpu
# Run scripts/download_model.py before enabling this. No implicit downloads.
NATUREDEX_MODEL_ENABLED=0
# All cached weights remain in the project folder.
HF_HOME=.model-cache
HF_HUB_OFFLINE=1
