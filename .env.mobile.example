# Optional protocol override when UDP is blocked; this still needs TCP port 7844.
# In PowerShell: $env:NATUREDEX_TUNNEL_PROTOCOL = 'http2'
NATUREDEX_TUNNEL_PROTOCOL=auto

# Optional path to an existing, official cloudflared client.
# NATUREDEX_CLOUDFLARED=C:\path\to\cloudflared.exe

# The launcher reads process environment variables, not this file automatically.
# Pairing secrets are generated fresh by npm run phone. Never set or commit them here.
