    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
